# Copy to .env (gitignored) or set these in your shell. Never commit real values.

# Which config/<profile>.yaml to load when --profile is not given.
IMAGINER_PROFILE=dev

# Static bearer token for the orchestrator's /v1 API. Optional on 127.0.0.1; required when
# the server is reachable from the network, which linking with other instances needs.
# IMAGINER_SERVER__AUTH_TOKEN=change-me

# API key for a llama-server started with --api-key / --api-key-file.
# The env var name is whatever the backend's `api_key_env` says in the profile.
# IMAGINER_LLAMA_LOCAL_KEY=change-me
